{
  "feature": "navigation-and-files",
  "title": "Navigation and files",
  "covers": [
    "$dirstack",
    "${(D)path}",
    "${var:?}",
    "[[ -nt ]]",
    "case",
    "cat -n",
    "cd",
    "cd -",
    "cd old new",
    "cd ~name",
    "cdpath",
    "chflags hidden",
    "chflags nohidden",
    "cp -R src/. dest/",
    "cp -X",
    "cp -p",
    "diff -r",
    "du -sk",
    "file --mime-type",
    "hash -d",
    "head -n",
    "head | tail",
    "ln -s",
    "ln -sf",
    "ln -sfn",
    "ls",
    "ls -1",
    "ls -A",
    "ls -F",
    "ls -t",
    "ls -tr",
    "mkdir",
    "mkdir -p",
    "mv",
    "mv -n",
    "popd",
    "pushd",
    "readlink",
    "rm --",
    "rm -f",
    "rmdir",
    "stat --version",
    "stat -c %s / stat -f %z",
    "tail -n",
    "tail -n +N",
    "touch -r",
    "touch -t",
    "while IFS= read -r",
    "xattr -w",
    "zstat",
    "~name"
  ]
}
