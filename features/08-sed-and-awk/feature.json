{
  "feature": "sed-and-awk",
  "title": "Editing streams with sed and awk",
  "covers": [
    "< <(sed",
    "OFS and NF",
    "array[key] +=",
    "array[key]++",
    "awk '$3 >= n'",
    "awk '/regex/'",
    "awk '{print $n}'",
    "awk -F'|'",
    "awk <<<",
    "awk BEGIN/END",
    "awk END",
    "awk printf",
    "case $line in",
    "case $role in",
    "length($1)",
    "length(array)",
    "printf \"%.2f\"",
    "sed '/pattern/d'",
    "sed 's/\\(a\\)\\(b\\)/x \\2/'",
    "sed 's/from/to/'",
    "sed 's/from/to/g'",
    "sed 's/pattern/& suffix/'",
    "sed --version",
    "sed -e 'cmd'",
    "sed -e 's/<tag>/|/g'",
    "sed -i ''",
    "sed -i.bak",
    "sed -n '/from/,/to/p'",
    "sed -n '/pattern/!p'",
    "sed -n '/pattern/p'",
    "sed -n '1,3p'",
    "sed -n '5{p;q;}'",
    "sed -n 'Np'",
    "sed | awk",
    "typeset -A"
  ]
}
