#!/usr/bin/env zsh
set -o errexit -o nounset -o pipefail
if [[ $1 == bundle && $2 == list ]]; then
  print -l gdal postgis qgis
  exit 0
fi
if [[ $1 == bundle && $2 == check ]]; then
  print "brew bundle can't satisfy your Brewfile's dependencies."
  print "Satisfy missing dependencies with `brew bundle install`."
  print "Missing formulae: postgis"
  exit 1
fi
print -u2 "stub brew: unsupported $*"
exit 1
