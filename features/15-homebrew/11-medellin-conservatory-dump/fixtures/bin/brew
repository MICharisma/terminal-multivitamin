#!/usr/bin/env zsh
set -o errexit -o nounset -o pipefail
if [[ $1 == bundle && $2 == dump ]]; then
  shift 2
  outfile=
  while (( $# )); do
    if [[ $1 == --file ]]; then
      outfile=$2
      shift 2
      continue
    fi
    shift
  done
  cat ${0:A:h:h}/live_brewfile.txt > ${outfile:?}
  exit 0
fi
print -u2 "stub brew: unsupported $*"
exit 1
