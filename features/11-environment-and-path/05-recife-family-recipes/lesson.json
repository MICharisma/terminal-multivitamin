      "api": "typeset -x",
      "regions": [
        {
          "name": "typeset-x",
          "role": "primary"
        }
      ]
    },
    {
      "label": "Lock the year with typeset -r",
      "api": "typeset -r",
      "regions": [
        {
          "name": "readonly",
          "role": "primary"
        },
        {
          "name": "typeset-x",
          "role": "setup"
        }
      ]
    },
    {
      "label": "Remove the export bit with typeset +x",
      "api": "typeset +x",
      "regions": [
        {
          "name": "unexport",
          "role": "primary"
        }
      ]
    }
  ]
}
