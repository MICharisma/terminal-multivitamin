{
  "feature": "pipes-and-redirection",
  "title": "Pipes and redirection",
  "covers": [
    "$( cmd 2>&1 1>&$fd )",
    "$?",
    "2> file",
    "2>&1",
    "2>&1 >/dev/null |",
    "2>&1 |",
    "2>/dev/null",
    ": > file",
    "<",
    "< /dev/null",
    "< a < b",
    "<(...)",
    "<<'EOF'",
    "<<-EOF",
    "<<<",
    "<<EOF",
    "=(...)",
    ">",
    "> /dev/null 2>&1",
    "> a > b",
    "> file 2>&1",
    "> file | cmd",
    ">>",
    ">> a >> b",
    ">|",
    "IFS=: read -r <<<",
    "PIPESTATUS",
    "comm -13",
    "comm -23 <(...) <(...)",
    "done < file",
    "done <<'EOF'",
    "exec 1>&3",
    "exec 3< file",
    "exec 3<&-",
    "exec 3>&1",
    "exec > file 2>&1",
    "exec {fd}>&-",
    "exec {fd}>file",
    "grep -c <<<",
    "mkfifo",
    "paste <(...) <(...)",
    "pbcopy < file",
    "pbpaste |",
    "pbpaste | sort -u | pbcopy",
    "read -A <<<",
    "read -u",
    "read -u 3 ... done 3< file",
    "set -o pipefail",
    "setopt no_multios",
    "sort f > f.new && mv",
    "tee",
    "tee -a",
    "tee a b >/dev/null",
    "tee stage | cmd",
    "trap ... | pbcopy",
    "wc -c <<<",
    "{ ...; } >> file",
    "|",
    "| pbcopy"
  ]
}
