{
  "feature": "quoting-and-parameter-expansion",
  "title": "Quoting and parameter expansion",
  "covers": [
    "\"$*\"",
    "\"$@\"",
    "\"${(@q)array}\"",
    "\"${(@s:,:)...}\"",
    "\"${array[@]}\"",
    "\"...\"",
    "$'...\\n...'",
    "$'...\\t...'",
    "$'\\t'",
    "$'\\x..'",
    "$array[2,4]",
    "${${var%/*/*}##*/}",
    "${(%)line}",
    "${(C)name}",
    "${(F)array}",
    "${(P)${:-${role}_host}}",
    "${(P)name}",
    "${(Q)name}",
    "${(U)name}",
    "${(e)template}",
    "${(f)...}",
    "${(j: | :)array}",
    "${(j:, :)${(@C)array}}",
    "${(k)assoc[(r)val]}",
    "${(kv)assoc}",
    "${(q)name}",
    "${(qq)name}",
    "${(r:28::.:)name}",
    "${(s:,:)...}",
    "${+assoc[key]}",
    "${a:|b}",
    "${array[(i)pattern]}",
    "${id:0:4}",
    "${name%%_*}",
    "${path##*/}",
    "${var%pattern}",
    "${var-default}",
    "${var//\"/\\\"}",
    "${var/old/new}",
    "${var:+value}",
    "${var:-default}",
    "${var:=default}",
    "${var:?message}",
    "${var^^}",
    "'...'",
    "'...'\\''...'",
    "'HK$'\"$price\"",
    "(( assoc[$k] += n ))",
    ":h :t",
    "IFS=$'\\t' read -r",
    "\\$",
    "array+=(...)",
    "osascript -e",
    "printf %q",
    "set -- $record",
    "set -f",
    "typeset -A",
    "unquoted $var",
    "unquoted glob",
    "zsh render.zsh"
  ]
}
