#!/usr/bin/env zsh
# Finding files with find and xargs · 05 · Vancouver game studio, counting source without node_modules
#
# Teaches:
#   - `-prune` stops `find` from going into a folder; `\( -name node_modules -o -name .git \) -prune
#     -o -name '*.ts' -print` is the standard shape
#   - the trailing `-print` matters: without it, `find` prints the pruned folders as well
#   - `-path` matches the whole path as `find` prints it, so `salmon-run/dist` works and `dist` alone does not
#   - `-mindepth 1 -maxdepth 1` lists only the top level; put them before any test (GNU `find` warns otherwise)
set -o errexit -o nounset -o pipefail

workdir=$(mktemp -d "${TMPDIR:-/tmp}/salmon-run-studio.XXXXXX")
trap 'rm -rf -- "$workdir"' EXIT
cd -- "$workdir"

repo=salmon-run
mkdir -p $repo/{src/game,src/ui,tools,tests,dist,.git/hooks}
for source in src/game/player.ts src/game/river.ts src/game/bear.ts src/ui/menu.ts \
              tools/build-atlas.ts tests/river.test.ts; do
  print "// $source: Salmon Run, a 2D river game" > $repo/$source
done
print "// generated by tsc, do not edit" > $repo/dist/game.d.ts
print "// sample hook from the git template" > $repo/.git/hooks/post-merge.ts
for package in phaser matter-js howler eventemitter3 tweenjs; do
  mkdir -p $repo/node_modules/$package/src
  for module in index core events loader scene; do
    print "// $package/$module" > $repo/node_modules/$package/src/$module.ts
  done
done

count() { print $(( $(wc -l) )) }

# region: everything
# focus: find $repo -name '*.ts'
print ".ts files anywhere in the repo: $(find $repo -name '*.ts' | count)"
# endregion: everything

# region: prune-folders
# focus: \( -name node_modules -o -name .git \) -prune -o -name '*.ts' -print
print "== the studio's own .ts files, node_modules and .git pruned:"
find $repo \( -name node_modules -o -name .git \) -prune -o -name '*.ts' -print | sort
# endregion: prune-folders

# region: forgot-print
# focus: -prune -o -name '*.ts' | sort
print "== the same without the final -print; the pruned folders sneak in:"
find $repo \( -name node_modules -o -name .git \) -prune -o -name '*.ts' | sort | grep -v '\.ts$'
# endregion: forgot-print

# region: prune-path
# focus: -path $repo/dist
print "dist files still listed, -path dist:            $(find $repo -path dist -prune -o -name '*.ts' -print | grep -c '^salmon-run/dist/')"
print "dist files still listed, -path $repo/dist: $(find $repo -path $repo/dist -prune -o -name '*.ts' -print | grep -c '^salmon-run/dist/')"
# endregion: prune-path

# region: top-level
# focus: -mindepth 1 -maxdepth 1 -type d
print "== top-level folders, for the README's layout section:"
find $repo -mindepth 1 -maxdepth 1 -type d | sort
# endregion: top-level
