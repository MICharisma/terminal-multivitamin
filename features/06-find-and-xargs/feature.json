    "[ -e \"$target\" ]",
    "array+=(\"$item\")",
    "cksum",
    "cp -p",
    "diff",
    "find ! -newer",
    "find -E / -regextype posix-extended",
    "find -delete",
    "find -empty",
    "find -exec sh -c",
    "find -exec stat -f {} +",
    "find -exec {} +",
    "find -exec {} \\;",
    "find -execdir",
    "find -iname",
    "find -mindepth -maxdepth",
    "find -name",
    "find -newer",
    "find -newer a ! -newer b",
    "find -path",
    "find -print0 | xargs -0",
    "find -printf",
    "find -prune -o -print",
    "find -regex",
    "find -size",
    "find -type d -empty -delete",
    "find -type f",
    "find -xattrname",
    "find \\( a -o b \\)",
    "find | while read",
    "grep",
    "grep pattern /dev/null {} +",
    "sort -rn",
