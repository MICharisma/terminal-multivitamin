{
  "feature": "globbing-and-expansion",
  "title": "Globbing and expansion",
  "covers": [
    "!(pattern)",
    "$#array",
    "${(l:3::0:)1}",
    "${~pattern}",
    "'quoted'",
    "(#i)",
    "(.)",
    "(.Lk-50oL^L0)",
    "(/)",
    "(/^F)",
    "(:t:r)",
    "(L0)",
    "(Lk+100)",
    "(N)",
    "(OL[1,3])",
    "(a|b)",
    "(m+30)",
    "(m-7)",
    "(mh-24)",
    "(n)",
    "(om[1])",
    "(u)",
    "*",
    "***/",
    "**/",
    "*/*",
    "+(pattern)",
    ":s/old/new/",
    ":t :h :r :e",
    "<n->",
    "<n-m>",
    "?",
    "@(a|b)",
    "[ -e \"$f\" ] || continue",
    "[...]",
    "[^...]",
    "^pattern",
    "case",
    "cp",
    "for f in glob",
    "pattern~exclusion",
    "set -- glob",
    "setopt extended_glob",
    "setopt nomatch",
    "setopt null_glob",
    "shopt -s nullglob",
    "strftime",
    "zmv",
    "zmv -W",
    "zmv -n",
    "{01..06}",
    "{01..12..3}",
    "{a,b}"
  ]
}
