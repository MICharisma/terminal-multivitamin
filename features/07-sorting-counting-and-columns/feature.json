{
  "feature": "sorting-counting-and-columns",
  "title": "Sorting, counting, and columns",
  "covers": [
    "array+=(\"$item\")",
    "column -t",
    "column -t -s $'\\t'",
    "comm -12",
    "comm -13",
    "comm -23",
    "cut -c",
    "cut -d",
    "cut -f",
    "cut -f -s",
    "cut -f1,2",
    "cut -f1,2 | sort | uniq -c",
    "cut -f1,3-",
    "join -t",
    "join -t,",
    "join -t, -1 1 -2 1",
    "join -v1",
    "join -v2",
    "paste",
    "paste -d",
    "paste -s",
    "rs -e 0 2",
    "rs -e 0 4",
    "sort -k1,1nr -k2,2",
    "sort -k3 vs -k3,3",
    "sort -k4,4nr",
    "sort -rn",
    "sort -t, -k1,1",
    "sort -t, -k4,4",
    "sort -t, -k4,4n -k5,5",
    "sort | uniq -c",
    "tr '[:upper:]' '[:lower:]'",
    "tr -c",
    "tr -d",
    "tr -s",
    "uniq -c",
    "wc -L",
    "wc -l -w -c",
    "wc -l <"
  ]
}
